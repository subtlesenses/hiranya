---
/**
 * One WhatsApp link, used everywhere. The number lives in a single Sanity field.
 *
 * If it is not set, nothing renders — better an absent button than one that
 * dials a stranger. The message is pre-written so the guest only presses send.
 */
interface Props {
  number?: string
  variant?: 'button' | 'inline' | 'plain'
  label?: string
  class?: string
}
const {number, variant = 'button', label, class: cls = ''} = Astro.props
const digits = (number ?? '').replace(/\D/g, '')
const text = 'Hello, I would like to ask about a room at Hiranya Guest House.'
const href = digits ? `https://wa.me/${digits}?text=${encodeURIComponent(text)}` : null
const shown = label ?? (digits ? `WhatsApp +${digits}` : 'WhatsApp')
---
{href && variant === 'button' && (
  <a class={`btn btn-wa ${cls}`} href={href} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.85 9.85 0 0 0 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.25 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.84-.2-.49-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.17 1.71 2.62 4.15 3.67.58.25 1.03.4 1.39.52.58.18 1.11.16 1.53.1.47-.07 1.47-.6 1.68-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.29Z"/></svg>
    <span>{shown}</span>
  </a>
)}
{href && variant === 'inline' && <a class={`wa-link ${cls}`} href={href} target="_blank" rel="noopener">{shown}</a>}
{href && variant === 'plain' && <a class={cls} href={href} target="_blank" rel="noopener">{shown}</a>}
