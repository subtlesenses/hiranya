---
import '../styles/global.css'
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Book your stay — Hiranya Guest House</title>
  <meta name="description" content="Choose your room and book your stay at Hiranya Guest House in Patan." />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Marcellus&family=IBM+Plex+Mono&display=swap" />
</head>
<body>
  <div class="booking-nav wrap"><a class="mark" href="/">Hiranya <small>Nakabahil · Patan</small></a><a href="/#rooms">Back to the house</a></div>
  <main class="wrap booking-main">
    <span class="eyebrow">Stay in old Patan</span><h1>Make yourself at home.</h1>
    <p>Choose your dates and room below. Review your total and booking conditions before confirming.</p>
    <div class="booking-shell">
      <iframe id="booking-frame" title="Room availability and reservations at Hiranya Guest House" width="100%" height="950" src="https://beds24.com/booking2.php?propid=355842&amp;cur=USD&amp;hideheader=yes&amp;referer=HiranyaWebsite&amp;cssfile=https%3A%2F%2Fwww.hiranyaguesthouse.com%2Fbeds24-theme.css"></iframe>
    </div>
    <p class="booking-help">Having trouble with the form? <a id="booking-fallback" href="https://beds24.com/booking2.php?propid=355842&amp;cur=USD" target="_blank" rel="noopener">Open booking in a new tab</a> or <a href="https://wa.me/9779841551450">contact us on WhatsApp</a>.</p>
  </main>
  <script>
    const frame = document.querySelector<HTMLIFrameElement>('#booking-frame')!
    const fallback = document.querySelector<HTMLAnchorElement>('#booking-fallback')!
    const query = new URLSearchParams(location.search)
    const target = new URL(frame.src)
    const dates = ['checkin', 'checkout']
    for (const name of dates) {
      const value = query.get(name)
      if (value && /^\d{4}-\d{2}-\d{2}$/.test(value)) target.searchParams.set(name, value)
    }
    for (const name of ['numnight', 'numadult', 'numchild']) {
      const value = query.get(name)
      if (value && /^\d{1,3}$/.test(value) && Number(value) <= 365) target.searchParams.set(name, value)
    }
    const allowedRooms = ['733187','733189','733192','733190','733191','733429','733432','733431']
    const room = query.get('roomid')
    if (room && allowedRooms.includes(room)) target.searchParams.set('roomid', room)
    frame.src = target.href
    fallback.href = target.href
  </script>
</body>
</html>
<style>
  .booking-nav{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-top:28px;padding-bottom:28px;border-bottom:1px solid var(--rule)}
  .booking-nav>a:last-child,.booking-help{font-size:14px;color:var(--chuna-dim)}
  .booking-main{padding-top:64px;padding-bottom:48px}.booking-main h1{font-size:clamp(2.5rem,6vw,5rem);line-height:1.1;margin:16px 0 24px}
  .booking-main>p{max-width:65ch;color:var(--chuna-dim)}
  .booking-shell{margin:36px 0 24px;border:1px solid var(--rule);background:var(--sal-2);border-radius:8px;overflow:hidden}
  iframe{display:block;border:0;width:100%;height:80vh;min-height:650px;background:var(--sal-2)}
  .booking-help a{color:var(--brass);text-decoration:underline}
  @media(max-width:600px){.booking-main{padding-top:32px}.booking-nav .mark small{display:none}.booking-shell{margin-left:-12px;margin-right:-12px}iframe{min-height:650px}}
</style>
