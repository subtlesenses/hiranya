# --- Sanity (content the owner edits) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Read token only needed for drafts/preview. Public datasets need nothing.
SANITY_READ_TOKEN=

# --- Beds24 (the calendar's single source of truth) ---
# Get a refresh token once, from Settings > Apps & Integrations > API in Beds24.
# Refresh tokens do not expire while used at least every 30 days.
BEDS24_REFRESH_TOKEN=
BEDS24_PROPERTY_ID=

# Rebuild the site when the owner publishes in Sanity.
# Paste this deploy hook URL into Sanity's webhook settings.
DEPLOY_HOOK_URL=
